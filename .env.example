# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# `.env` git'e gönderilmez (.gitignore).

# Google AI Studio API anahtarı: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Kullanılacak Gemini modeli (opsiyonel). Boşsa gemini-flash-latest kullanılır.
GEMINI_MODEL=gemini-flash-latest
